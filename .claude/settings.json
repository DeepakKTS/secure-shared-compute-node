{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-galaxy:*)",
      "Bash(yamllint:*)",
      "Bash(shellcheck:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(multipass list:*)",
      "Bash(multipass info:*)",
      "Bash(multipass exec:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(multipass delete:*)",
      "Bash(multipass purge:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(make lab-down:*)",
      "Bash(scripts/lab.sh down:*)",
      "Bash(./scripts/lab.sh down:*)",
      "Bash(multipass restore:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -R:*)",
      "Bash(/bin/rm:*)",
      "Bash(find * -delete*)"
    ],
    "deny": [
      "Read(./.lab/keys/**)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_delete.py\"; rc=$?; [ \"$rc\" -eq 0 ] && exit 0; [ \"$rc\" -eq 2 ] || echo \"guard_delete: hook failed (exit $rc), blocking the command\" >&2; exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
