.lab/
inventory/lab.yml
# gen_inventory.py writes here, then renames; a crash leaves lab IPs in it.
inventory/.lab.yml.tmp
*.retry
.venv/
.ansible/
__pycache__/
.pytest_cache/
.ruff_cache/
*.vault
# Ansible Vault password files. This project keeps its vault password at
