# Generated by scripts/gen_inventory.py into inventory/lab.yml (gitignored).
# This file doubles as the allowlist for simulation targets.
all:
  vars:
    ansible_user: ssc-admin
    ansible_ssh_private_key_file: .lab/keys/ssc_admin_ed25519
    lab_cidr: 192.168.64.0/24   # example only; real value comes from multipass
  children:
    node:
      hosts:
        ssc-node: {ansible_host: 192.168.64.10}
    monitor:
      hosts:
        ssc-monitor: {ansible_host: 192.168.64.11}
    attacker:
      hosts:
        ssc-attacker: {ansible_host: 192.168.64.12}
