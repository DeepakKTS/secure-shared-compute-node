# Generated by scripts/gen_inventory.py into inventory/lab.yml (gitignored).
# This file doubles as the allowlist for simulation targets.
# Paths are absolute in the generated file; shown relative here.
all:
  vars:
    ansible_user: ssc-admin
    ansible_ssh_private_key_file: .lab/keys/ssc_admin_ed25519
    ansible_ssh_common_args: >-
      -o IdentitiesOnly=yes
      -o UserKnownHostsFile=.lab/known_hosts
      -o StrictHostKeyChecking=accept-new
    ansible_python_interpreter: /usr/bin/python3
    lab_profile: full                # full | small
    lab_cidr: 192.168.64.0/24        # example only; the host's Multipass bridge network, at most a /24
    lab_controller_ip: 192.168.64.1  # example only; the host's address on the lab network
  children:
    node:
      hosts:
        ssc-node: {ansible_host: 192.168.64.10}
    monitor:
      hosts:
        ssc-monitor: {ansible_host: 192.168.64.11}
    attacker:
      hosts:
        ssc-attacker: {ansible_host: 192.168.64.12}
