# Managed by Ansible (role: auditd). Do not edit by hand.
#
# The noble default (auditd 1:3.1.2), with the log size and the disk actions
# set in roles/auditd/defaults/main.yml. The README says why each action was
# chosen. No action is single or halt: any user who fills the disk could
# then take the shared node down for everyone.
local_events = yes
write_logs = yes
log_file = /var/log/audit/audit.log
log_group = adm
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ auditd_max_log_file }}
num_logs = {{ auditd_num_logs }}
priority_boost = 4
name_format = NONE
max_log_file_action = ROTATE
space_left = {{ auditd_space_left }}
space_left_action = {{ auditd_space_left_action | upper }}
verify_email = yes
action_mail_acct = root
admin_space_left = {{ auditd_admin_space_left }}
admin_space_left_action = {{ auditd_admin_space_left_action | upper }}
disk_full_action = {{ auditd_disk_full_action | upper }}
disk_error_action = {{ auditd_disk_error_action | upper }}
use_libwrap = yes
tcp_listen_queue = 5
tcp_max_per_addr = 1
tcp_client_max_idle = 0
transport = TCP
krb5_principal = auditd
distribute_network = no
q_depth = 2000
overflow_action = SYSLOG
max_restarts = 10
plugin_dir = /etc/audit/plugins.d
end_of_event_timeout = 2
