# Managed by Ansible (role: base). Do not edit by hand.
# Why each value is set: roles/base/defaults/main.yml.
# The 99-zz- name makes this file apply after every vendor sysctl.d file.
# Change these values in inventory/group_vars, not in /etc/sysctl.conf.

{% set base_sysctl_first = ['net.ipv4.ip_forward', 'net.ipv6.conf.all.forwarding'] %}
# Forwarding first. When net.ipv4.ip_forward changes, the kernel resets
# net.ipv4.conf.all.accept_redirects (to 1 when forwarding goes off), so it
# must be set before the redirect settings below.
{% for key in base_sysctl_first if key in base_sysctl %}
{{ key }} = {{ base_sysctl[key] }}
{% endfor %}

{% for key, value in base_sysctl | dictsort if key not in base_sysctl_first %}
{{ key }} = {{ value }}
{% endfor %}

# The kernel uses the larger of "all" and the per-interface value, and
# Ubuntu sets every interface to 2, so the glob is needed for strict mode.
net.ipv4.conf.all.rp_filter = {{ base_rp_filter }}
net.ipv4.conf.default.rp_filter = {{ base_rp_filter }}
net.ipv4.conf.*.rp_filter = {{ base_rp_filter }}
